SECRET_KEY=zmien-na-losowy-dlugi-ciag
JWT_SIGNING_KEY=zmien-na-inny-losowy-ciag-min-32-znaki
DEBUG=true
DB_NAME=cocktails
DB_USER=postgres
DB_PASSWORD=twoje-haslo-do-postgresa
DB_HOST=localhost
DB_PORT=5432
# adresy frontendu, którym wolno czytać API (po przecinku)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# opcjonalne: tryb TLS do bazy (lokalnie prefer; na produkcji require, a przy dostawcy z certyfikatem verify-full)
# DB_SSLMODE=require
# opcjonalne: parametry Argon2 (domyślnie 64 MiB, 3 przebiegi, 2 wątki); dobierz do hosta
# ARGON2_MEMORY_KIB=65536
# ARGON2_TIME_COST=3
# ARGON2_PARALLELISM=2
# opcjonalne: zamiast DB_NAME, DB_USER, DB_PASSWORD, DB_HOST, DB_PORT można podać jeden adres (tak robi hosting)
# DATABASE_URL=postgresql://uzytkownik:haslo@host/nazwa?sslmode=require
# opcjonalne: adresy (https://...) dla CSRF panelu /admin/, po przecinku
# CSRF_TRUSTED_ORIGINS=https://twoj-backend.vercel.app
